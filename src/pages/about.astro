---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import hero from '@/assets/images/hero-cnc-workshop.jpg';
import grinding from '@/assets/images/cap-centreless-grinding.jpg';
import { site, fullAddress } from '@/data/site';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about/' },
];

const machines = [
  { name: 'ACE CNC lathe', process: 'CNC turning', href: '/capabilities/cnc-turning/' },
  { name: 'Trishul', process: 'Polygon milling', href: '/capabilities/polygon-milling/' },
  { name: 'Bhavans Sons', process: 'Centreless grinding', href: '/capabilities/centreless-grinding/' },
  { name: 'Laxon', process: 'Bar & bundle stock cutting', href: '/capabilities/bundle-cutting/' },
  { name: 'HMT', process: 'Pillar drilling', href: '/capabilities/pillar-drilling/' },
];

const facts = [
  { label: 'Business', value: site.name },
  { label: 'Specialisation', value: site.tagline },
  { label: 'General Manager', value: site.generalManager.name },
  { label: 'Experience', value: `${site.experienceYears} years` },
  { label: 'Team', value: `${site.workforce} skilled workers` },
  { label: 'Location', value: fullAddress },
  { label: 'GSTIN', value: site.gstin },
  { label: 'Registration', value: 'MSME' },
];
---

<BaseLayout
  title="About Antrrow Auto Parts - 35 Years of Machining in Chennai"
  description="Antrrow Auto Parts, Padi, Chennai: 35 years of CNC turned components, polygon milling and centreless grinding. General Manager: M Justin Rajan."
  keywords={['Antrrow Auto Parts', 'machining company Padi Chennai', 'CNC turned components Chennai']}
  breadcrumbs={breadcrumbs}
  pageType="AboutPage"
>
  <PageHeader
    eyebrow="About us"
    title="A Chennai Machining Partner with 35 Years of Experience"
    lead={`${site.name} is a Chennai-based engineering component manufacturer and machining partner that makes components to customer requirements and drawings.`}
    breadcrumbs={breadcrumbs}
    image={hero}
  />

  <section class="py-16 md:py-24">
    <div class="container-site grid items-start gap-12 lg:grid-cols-2" data-stagger="150">
      <div class="prose-site">
        <p class="eyebrow">Who we are</p>
        <h2>CNC turned components, grinding &amp; polygon milling works</h2>
        <p>
          From our workshop on Kamaraj Street in Gopal Naicker Nagar, Padi, we manufacture custom and repeat-batch
          metal components against agreed drawings, samples, dimensions and material requirements.
        </p>
        <p>
          Our work covers clutch pins, bushes, pads, brackets and levers for clutch and driveline component makers,
          as well as rods, shafts, piston rods, special bolts and child parts for industrial customers and
          two-wheeler supply chains.
        </p>
        <h3>Our approach</h3>
        <ul>
          <li><strong>Drawing first</strong> - every job starts with a review of your drawing, sample and specification.</li>
          <li><strong>Clear feasibility</strong> - we confirm what suits our machines before we quote.</li>
          <li><strong>One workshop</strong> - cutting, turning, milling, drilling and grinding under one roof.</li>
          <li><strong>Accurate claims</strong> - we describe only the capabilities we actually have.</li>
        </ul>
      </div>
      <Image
        src={grinding}
        alt="Centreless grinding of a steel rod at the Antrrow Auto Parts workshop"
        widths={[480, 800, 1024]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="aspect-4/3 w-full rounded-2xl object-cover shadow-xl"
      />
    </div>
  </section>

  <section class="bg-brand-navy-900 py-16 text-white md:py-20">
    <div class="container-site grid items-center gap-10 md:grid-cols-3" data-stagger="120">
      <div class="md:col-span-2">
        <p class="eyebrow">Leadership</p>
        <h2 class="mt-3 text-4xl text-white">{site.generalManager.name}</h2>
        <p class="mt-1 text-lg text-brand-red">{site.generalManager.role}</p>
        <p class="mt-4 max-w-2xl text-white/80">
          {site.generalManager.name} leads day-to-day operations at {site.name} - from requirement review and
          quotations to production planning and customer support. Reach out directly to discuss a component
          requirement.
        </p>
      </div>
      <div class="space-y-3">
        <a href={`tel:${site.phones.mobile.tel}`} class="btn-primary w-full"><Icon name="phone" class="size-5" />{site.phones.mobile.display}</a>
        <a href={`mailto:${site.email}`} class="btn-ghost-light w-full"><Icon name="mail" class="size-5" />Email us</a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-site grid gap-12 lg:grid-cols-2" data-stagger="150">
      <div>
        <p class="eyebrow">Our machines</p>
        <h2 class="mt-3 text-4xl">Equipment in our Padi workshop</h2>
        <ul class="mt-8 divide-y divide-steel-200 rounded-xl border border-steel-200">
          {machines.map((m) => (
            <li>
              <a href={m.href} class="flex items-center justify-between gap-4 p-5 hover:bg-steel-50">
                <span>
                  <span class="block font-semibold text-steel-900">{m.process}</span>
                  <span class="text-sm text-steel-500">{m.name}</span>
                </span>
                <Icon name="arrow" class="size-5 text-brand-red" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Company facts</p>
        <h2 class="mt-3 text-4xl">At a glance</h2>
        <dl class="mt-8 divide-y divide-steel-200 rounded-xl border border-steel-200">
          {facts.map((f) => (
            <div class="grid gap-1 p-5 sm:grid-cols-3">
              <dt class="text-sm font-semibold text-steel-500">{f.label}</dt>
              <dd class="text-steel-900 sm:col-span-2">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
