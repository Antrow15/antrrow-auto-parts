---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import ProductCard from '@/components/ProductCard.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { faqSchema, serviceSchema } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const capabilities = await getCollection('capabilities');
  return capabilities.map((capability) => ({ params: { slug: capability.id }, props: { capability } }));
}) satisfies GetStaticPaths;

interface Props {
  capability: CollectionEntry<'capabilities'>;
}

const { capability } = Astro.props;
const { data } = capability;
const { Content } = await render(capability);

const relatedProducts = (await getCollection('products'))
  .filter((p) => p.data.capabilities.some((ref) => ref.id === capability.id))
  .sort((a, b) => a.data.order - b.data.order);
const otherCapabilities = (await getCollection('capabilities'))
  .filter((c) => c.id !== capability.id)
  .sort((a, b) => a.data.order - b.data.order);
const ogImage = await getImage({ src: data.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const path = `/capabilities/${capability.id}/`;
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Capabilities', href: '/capabilities/' },
  { name: data.title, href: path },
];
---

<BaseLayout
  title={data.metaTitle}
  description={data.description}
  image={ogImage.src}
  imageAlt={data.imageAlt}
  keywords={data.keywords}
  breadcrumbs={breadcrumbs}
  schema={[
    serviceSchema({
      name: `${data.title} services`,
      description: data.description,
      path,
      image: ogImage.src,
      serviceType: data.title,
      offers: data.applications,
    }),
    ...(data.faqs.length ? [faqSchema(data.faqs)] : []),
  ]}
>
  <PageHeader eyebrow={data.machine} title={data.h1} lead={data.summary} breadcrumbs={breadcrumbs}>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/request-a-quote/" class="btn-primary">Request a Quote <Icon name="arrow" class="size-4" /></a>
      <a href="/contact/" class="btn-ghost-light">Talk to our team</a>
    </div>
  </PageHeader>

  <section class="py-16 md:py-20">
    <div class="container-site grid gap-12 lg:grid-cols-3" data-stagger="150">
      <div class="lg:col-span-2">
        <Image
          src={data.image}
          alt={data.imageAlt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 66vw, 100vw"
          loading="eager"
          class="aspect-16/10 w-full rounded-2xl object-cover"
        />
        <div class="prose-site mt-10">
          <Content />
        </div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-xl border border-steel-200 p-6">
          <h2 class="text-2xl">Typical applications</h2>
          <ul class="mt-4 space-y-2.5">
            {data.applications.map((a) => (
              <li class="flex gap-2.5 text-steel-700"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand-red" />{a}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-steel-200 bg-steel-50 p-6">
          <h2 class="text-2xl">Benefits</h2>
          <ul class="mt-4 space-y-2.5">
            {data.benefits.map((b) => (
              <li class="flex gap-2.5 text-steel-700"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-brand-navy" />{b}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl bg-brand-navy-900 p-6 text-white">
          <h2 class="text-2xl text-white">Other capabilities</h2>
          <ul class="mt-4 space-y-2">
            {otherCapabilities.map((c) => (
              <li>
                <a href={`/capabilities/${c.id}/`} class="flex items-center justify-between rounded-md bg-white/5 px-4 py-3 text-sm font-medium hover:bg-white/10">
                  {c.data.title} <Icon name="arrow" class="size-4 text-brand-red" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {
    relatedProducts.length > 0 && (
      <section class="bg-steel-50 py-16 md:py-20">
        <div class="container-site">
          <p class="eyebrow">Products</p>
          <h2 class="mt-3 text-3xl md:text-4xl">Components made with {data.title.toLowerCase()}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
            {relatedProducts.map((p) => <ProductCard product={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <Faq faqs={data.faqs} title={`${data.title} - FAQs`} />
  <CtaBand />
</BaseLayout>
