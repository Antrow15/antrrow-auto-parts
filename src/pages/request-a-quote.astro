---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import RfqForm from '@/components/forms/RfqForm.astro';
import hero from '@/assets/images/prod-custom-drawing.jpg';
import { site } from '@/data/site';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Request a Quote', href: '/request-a-quote/' },
];

const steps = [
  { title: 'Share your requirement', text: 'Fill in the form with your component, material and quantity.' },
  { title: 'Send drawings', text: 'Attach drawings or photos of the sample in the pre-filled email or WhatsApp.' },
  { title: 'Feasibility review', text: 'We review the drawing and confirm the manufacturing route.' },
  { title: 'Quotation', text: 'You receive a quotation for samples or batch production.' },
];
---

<BaseLayout
  title="Request a Quote - Custom CNC Turned Components in Chennai"
  description="Request a quotation for custom CNC turned components, pins, bushes, shafts, levers and drawing-based parts from Antrrow Auto Parts, Padi, Chennai."
  keywords={['request quote CNC turned parts', 'machining quotation Chennai', 'RFQ turned components']}
  breadcrumbs={breadcrumbs}
  pageType="ContactPage"
>
  <PageHeader
    eyebrow="Request a quote"
    title="Request a Quotation for Your Component"
    lead="Tell us about your part. We review every drawing for manufacturability before quoting."
    breadcrumbs={breadcrumbs}
    image={hero}
  />

  <section class="py-16 md:py-20">
    <div class="container-site grid gap-12 lg:grid-cols-3" data-stagger="150">
      <div class="rounded-2xl border border-steel-200 bg-white p-6 shadow-sm md:p-10 lg:col-span-2">
        <h2 class="text-3xl">Request for quotation</h2>
        <p class="mt-2 text-steel-700">Fields marked <span class="text-brand-red">*</span> are required.</p>
        <div class="mt-8"><RfqForm /></div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-xl bg-brand-navy-900 p-6 text-white">
          <h2 class="text-2xl text-white">What happens next</h2>
          <ol class="mt-5 space-y-5">
            {steps.map((s, i) => (
              <li class="flex gap-4">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-red text-sm font-bold">{i + 1}</span>
                <span>
                  <span class="block font-semibold">{s.title}</span>
                  <span class="text-sm text-white/75">{s.text}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
        <div class="rounded-xl border border-steel-200 p-6">
          <h2 class="text-2xl">Prefer to call?</h2>
          <p class="mt-2 text-sm text-steel-700">Speak with {site.generalManager.name}, {site.generalManager.role}.</p>
          <ul class="mt-4 space-y-3">
            <li><a href={`tel:${site.phones.mobile.tel}`} class="flex items-center gap-3 font-semibold text-brand-navy"><Icon name="phone" class="size-5 text-brand-red" />{site.phones.mobile.display}</a></li>
            <li><a href={`tel:${site.phones.landline.tel}`} class="flex items-center gap-3 font-semibold text-brand-navy"><Icon name="phone" class="size-5 text-brand-red" />{site.phones.landline.display}</a></li>
            <li><a href={`mailto:${site.email}`} class="flex items-center gap-3 break-all font-semibold text-brand-navy"><Icon name="mail" class="size-5 shrink-0 text-brand-red" />{site.email}</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
