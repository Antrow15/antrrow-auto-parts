---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProcessTimeline from '@/components/ProcessTimeline.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import hero from '@/assets/images/quality-inspection.jpg';
import packing from '@/assets/images/packing-dispatch.jpg';
import drawing from '@/assets/images/prod-custom-drawing.jpg';
import { processStages } from '@/data/site';
import { faqSchema } from '@/lib/schema';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Quality & Process', href: '/quality-process/' },
];

const faqs = [
  {
    q: 'How do you check components before dispatch?',
    a: 'Dimensions specified on the drawing are checked with hand measuring instruments such as vernier calipers and micrometers against the agreed acceptance criteria.',
  },
  {
    q: 'Do you provide inspection reports?',
    a: 'Please mention any inspection report or documentation requirement in your enquiry so it can be agreed before production.',
  },
  {
    q: 'How are parts packed?',
    a: 'Components are protected against damage and corrosion, counted and labelled. Customer-specific packing can be agreed for repeat orders.',
  },
];

const howToSchema = {
  '@type': 'HowTo',
  name: 'How Antrrow Auto Parts manufactures a custom component',
  step: processStages.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.text })),
};
---

<BaseLayout
  title="Quality & Process - From Drawing Review to Dispatch"
  description="How Antrrow Auto Parts manufactures custom components in Chennai: requirement review, material checks, machining, grinding, dimensional inspection, packing and dispatch."
  keywords={['machining quality process', 'dimensional inspection Chennai', 'component manufacturing process']}
  breadcrumbs={breadcrumbs}
  schema={[howToSchema, faqSchema(faqs)]}
>
  <PageHeader
    eyebrow="Quality & process"
    title="From Drawing Review to Dispatch - Our Manufacturing Process"
    lead="A clear, repeatable route for every component: review, material checks, machining, grinding, inspection, packing and dispatch."
    breadcrumbs={breadcrumbs}
    image={hero}
  />

  <section class="py-16 md:py-24">
    <div class="container-site">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Nine stages</p>
        <h2 class="mt-3 text-4xl md:text-5xl">How every job moves through our workshop</h2>
      </div>
      <div class="mt-10"><ProcessTimeline /></div>
    </div>
  </section>

  <section class="bg-steel-50 py-16 md:py-24">
    <div class="container-site space-y-16">
      <div data-reveal class="grid items-center gap-10 lg:grid-cols-2">
        <Image src={drawing} alt="Engineering drawing reviewed alongside a sample shaft and vernier caliper" widths={[480, 800, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-4/3 w-full rounded-2xl object-cover" />
        <div class="prose-site">
          <h2>Requirement review comes first</h2>
          <p>
            Before any material is cut, we check the drawing revision, sample, quantity, material, tolerances, finish
            and delivery date. If a feature does not suit our setup, we tell you at this stage - not after production.
          </p>
        </div>
      </div>
      <div data-reveal class="grid items-center gap-10 lg:grid-cols-2">
        <Image src={hero} alt="Micrometer measuring a turned pin during dimensional inspection" widths={[480, 800, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-4/3 w-full rounded-2xl object-cover lg:order-2" />
        <div class="prose-site">
          <h2>Dimensional inspection</h2>
          <p>
            Dimensions specified on the drawing are checked with hand measuring instruments, such as vernier
            calipers and micrometers, against the agreed acceptance criteria.
          </p>
        </div>
      </div>
      <div data-reveal class="grid items-center gap-10 lg:grid-cols-2">
        <Image src={packing} alt="Machined components wrapped in anti-corrosion paper and boxed for dispatch" widths={[480, 800, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-4/3 w-full rounded-2xl object-cover" />
        <div class="prose-site">
          <h2>Packing and dispatch</h2>
          <p>
            Finished components are protected against damage and corrosion, counted and labelled, with packing lists and
            delivery coordinated with you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} title="Quality & process FAQs" />
  <CtaBand />
</BaseLayout>
