---
import { processStages } from '@/data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const stages = compact ? processStages.slice(0, 6) : processStages;
---

<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger="80">
  {
    stages.map((stage, i) => (
      <li class="group relative overflow-hidden rounded-xl border border-steel-200 bg-white p-6 transition-all duration-500 ease-(--ease-out-expo) hover:-translate-y-1 hover:border-brand-red/30 hover:shadow-xl">
        <span class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-brand-red transition-transform duration-500 ease-(--ease-out-expo) group-hover:scale-x-100" aria-hidden="true" />
        <span class="font-display text-5xl font-bold text-brand-red/15 transition-colors duration-500 group-hover:text-brand-red/40">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-1 text-xl">{stage.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-steel-700">{stage.text}</p>
      </li>
    ))
  }
</ol>
