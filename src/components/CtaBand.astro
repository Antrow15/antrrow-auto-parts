---
import Icon from './Icon.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Have a drawing or sample? Let’s review it.',
  text = 'Share your drawing, sample or specification with material and quantity. We will review manufacturability and respond with a quotation.',
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-brand-red">
  <Icon name="cog" class="gear-spin pointer-events-none absolute -top-24 -right-20 -z-10 size-96 text-white/10" />
  <div data-reveal class="container-site flex flex-col gap-8 py-14 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-3xl text-white md:text-4xl">{title}</h2>
      <p class="mt-3 text-white/90">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/request-a-quote/" class="btn bg-white text-brand-red hover:bg-brand-navy-900 hover:text-white">
        Request a Quotation
        <Icon name="arrow" class="size-4" />
      </a>
      <a href={`tel:${site.phones.mobile.tel}`} class="btn-ghost-light">
        <Icon name="phone" class="size-4" />
        {site.phones.mobile.display}
      </a>
    </div>
  </div>
</section>
