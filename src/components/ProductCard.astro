---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  product: CollectionEntry<'products'>;
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel = 'h3' } = Astro.props;
const { data } = product;
const Heading = headingLevel;
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-steel-200 bg-white transition-all duration-500 ease-(--ease-out-expo) hover:-translate-y-1.5 hover:border-brand-navy/20 hover:shadow-2xl hover:shadow-brand-navy/10">
  <a href={`/products/${product.id}/`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <Image
      src={data.image}
      alt=""
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="aspect-4/3 w-full object-cover transition-transform duration-700 ease-(--ease-out-expo) group-hover:scale-110"
    />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <Heading class="text-2xl">
      <a href={`/products/${product.id}/`} class="hover:text-brand-red">{data.title}</a>
    </Heading>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-steel-700">{data.summary}</p>
    <a
      href={`/products/${product.id}/`}
      class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-red"
      aria-label={`View ${data.title}`}
    >
      View details <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</article>
