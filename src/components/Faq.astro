---
import Icon from './Icon.astro';

interface Props {
  faqs: readonly { q: string; a: string }[];
  title?: string;
}

const { faqs, title = 'Frequently asked questions' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="bg-steel-50 py-16 md:py-20">
      <div class="container-site max-w-4xl">
        <div data-reveal>
          <p class="eyebrow">FAQ</p>
          <h2 class="mt-3 text-3xl md:text-4xl">{title}</h2>
        </div>
        <div data-reveal style="--reveal-delay: 120ms" class="mt-8 divide-y divide-steel-200 rounded-xl border border-steel-200 bg-white">
          {faqs.map((f) => (
            <details class="faq-item group p-5 transition-colors duration-300 open:bg-steel-50/60 md:p-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-steel-900 [&::-webkit-details-marker]:hidden">
                <h3 class="font-sans text-base font-semibold tracking-normal text-steel-900">{f.q}</h3>
                <Icon name="chevron" class="mt-0.5 size-5 shrink-0 text-brand-red transition-transform duration-300 ease-(--ease-out-expo) group-open:rotate-180" />
              </summary>
              <p class="mt-3 leading-relaxed text-steel-700">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
