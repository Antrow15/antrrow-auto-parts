---
import Icon from '../Icon.astro';
import { site } from '@/data/site';
---

<div data-form-success hidden tabindex="-1" class="rounded-xl border border-steel-200 bg-white p-6 outline-none md:p-8" role="status">
  <div class="flex size-12 items-center justify-center rounded-full bg-brand-navy/10 text-brand-navy">
    <Icon name="check" class="size-6" />
  </div>

  <div data-state="delivered" hidden>
    <h3 class="mt-4 text-2xl">Thank you - your enquiry has been sent</h3>
    <p class="mt-2 text-steel-700">Our team will review your requirement and get back to you.</p>
  </div>

  <div data-state="pending">
    <h3 class="mt-4 text-2xl">Your enquiry is ready to send</h3>
    <p class="mt-2 text-steel-700">
      Choose how you would like to send it. Your details are pre-filled, so just press send in your email
      or WhatsApp app. You can attach drawings directly in that message.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`mailto:${site.email}`} data-send-email class="btn-secondary">
        <Icon name="mail" class="size-5" /> Send via Email
      </a>
      <a href={`https://wa.me/${site.whatsapp}`} data-send-whatsapp target="_blank" rel="noopener" class="btn bg-[#25D366] text-white hover:bg-[#1da851]">
        <Icon name="whatsapp" class="size-5" /> Send via WhatsApp
      </a>
    </div>
    <p class="mt-4 text-sm text-steel-500">
      Prefer to talk? Call <a href={`tel:${site.phones.mobile.tel}`} class="font-semibold text-brand-navy">{site.phones.mobile.display}</a>{' '}
      or <a href={`tel:${site.phones.landline.tel}`} class="font-semibold text-brand-navy">{site.phones.landline.display}</a>.
    </p>
  </div>

  <button type="button" data-form-reset class="mt-6 text-sm font-semibold text-brand-red underline underline-offset-4">
    Start a new enquiry
  </button>
</div>
