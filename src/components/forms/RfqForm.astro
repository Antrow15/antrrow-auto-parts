---
import Field from './Field.astro';
import FormSuccess from './FormSuccess.astro';
import { componentCategories } from '@/data/site';

const id = 'rfq';
---

<div data-form-wrapper>
  <form data-enquiry-form data-kind="rfq" class="space-y-10" aria-label="Request for quotation form">
    <fieldset class="grid gap-5 sm:grid-cols-2">
      <legend class="mb-5 font-display text-2xl font-bold text-brand-navy-900">1. Your details</legend>
      <Field formId={id} name="name" label="Contact person" required autocomplete="name" maxlength={80} />
      <Field formId={id} name="company" label="Company" required autocomplete="organization" maxlength={120} />
      <Field formId={id} name="email" label="Business email" type="email" autocomplete="email" inputmode="email" maxlength={120} hint="Email or phone - at least one is required." />
      <Field formId={id} name="phone" label="Phone / WhatsApp" type="tel" autocomplete="tel" inputmode="tel" maxlength={18} />
      <Field formId={id} name="city" label="City" autocomplete="address-level2" maxlength={60} class="sm:col-span-2" />
    </fieldset>

    <fieldset class="grid gap-5 sm:grid-cols-2">
      <legend class="mb-5 font-display text-2xl font-bold text-brand-navy-900">2. Component requirement</legend>
      <Field formId={id} name="category" label="Component category" as="select" options={componentCategories} required />
      <Field formId={id} name="partName" label="Part name / number" maxlength={120} />
      <Field
        formId={id}
        name="description"
        label="Requirement description"
        as="textarea"
        required
        minlength={15}
        maxlength={3000}
        rows={5}
        placeholder="Describe the part, key dimensions, operations needed (turning, flats, holes, grinding) and its application."
        class="sm:col-span-2"
      />
      <Field formId={id} name="material" label="Material / grade" placeholder="e.g. EN8, EN19, SS304, brass" maxlength={120} />
      <Field formId={id} name="drawingRev" label="Drawing number & revision" maxlength={120} />
      <Field formId={id} name="firstQty" label="First order quantity" inputmode="numeric" maxlength={30} />
      <Field formId={id} name="repeatQty" label="Monthly / annual quantity" maxlength={60} placeholder="e.g. 2,000 per month" />
      <Field formId={id} name="targetDate" label="Target delivery date" type="date" />
      <Field formId={id} name="sample" label="Sample available?" as="select" options={['Yes - can send a sample', 'No - drawing only', 'Not sure']} />
      <Field
        formId={id}
        name="finishing"
        label="Finishing / heat-treatment / plating needs"
        as="textarea"
        rows={3}
        maxlength={1000}
        placeholder="e.g. ground OD, zinc plating, case hardening"
        class="sm:col-span-2"
      />
    </fieldset>

    <div class="rounded-lg border border-dashed border-brand-navy/30 bg-brand-navy/5 p-4 text-sm text-steel-700">
      <strong class="text-brand-navy-900">Drawings:</strong> to keep your drawings private, we don't upload files through
      this website. After submitting, you can attach drawings directly to the pre-filled email or WhatsApp message.
    </div>

    <div data-honeypot class="absolute -left-[9999px]" aria-hidden="true">
      <label for={`${id}-website`}>Website</label>
      <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div>
      <label class="flex items-start gap-3 text-sm text-steel-700">
        <input type="checkbox" name="consent" required class="mt-1 size-4 accent-brand-navy" aria-describedby={`${id}-consent-error`} />
        <span>
          I agree that Antrrow Auto Parts may use these details to review my requirement and prepare a quotation, as
          described in the <a href="/privacy/" class="font-medium text-brand-navy underline">privacy notice</a>.
        </span>
      </label>
      <p id={`${id}-consent-error`} class="field-error" data-error-for="consent" hidden></p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <button type="submit" class="btn-primary px-8 disabled:opacity-60">Submit Request for Quotation</button>
      <p data-form-status class="text-sm font-medium text-brand-red-700" aria-live="polite"></p>
    </div>
  </form>
  <FormSuccess />
</div>

<script>
  import '@/scripts/enquiry-form';
</script>
